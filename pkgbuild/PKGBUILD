pkgname=study
pkgver=0.1.0
pkgrel=1
pkgdesc='Read folders of Markdown: a file tree, tabs, and rendered documents with the source a toggle away'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-webengine' 'qt6-webchannel' 'qt6-svg' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/study "$pkgdir/usr/bin/study"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/study.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/study.svg"
  install -Dm644 "$startdir/study.desktop" "$pkgdir/usr/share/applications/study.desktop"
}
