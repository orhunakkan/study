#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# The page bundle is generated; rebuild it when it's missing or older than
# its sources.
DIST="$ROOT/src/web/dist"
if [ ! -f "$DIST/web.qrc" ] || [ -n "$(find "$ROOT/web" -maxdepth 1 -type f -newer "$DIST/web.qrc" 2>/dev/null)" ]; then
    "$ROOT/web/build"
fi

mkdir -p "$ROOT/build"
cd "$ROOT/build"

qmake6 "$ROOT/study.pro"
make -j"$(nproc)"

echo "Built $ROOT/build/study"
